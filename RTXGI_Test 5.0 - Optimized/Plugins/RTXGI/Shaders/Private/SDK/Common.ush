//Fully Optimized By RedPixel
#ifndef RTXGI_COMMON_HLSL
#define RTXGI_COMMON_HLSL

static const float RTXGI_PI   = 3.1415926535897932f;
static const float RTXGI_2PI  = 6.2831853071795864f;
static const float RTXGI_INV_1023 = 0.0009775171065493646f; // 1/1023

//------------------------------------------------------------------------
// Math Helpers (optimized; branchless where possible, fused ops)
//------------------------------------------------------------------------

inline float RTXGIMinComponent(float3 a)
{
    return min(a.x, min(a.y, a.z));
}

inline float RTXGIMaxComponent(float3 a)
{
    return max(a.x, max(a.y, a.z));
}

// Returns +1 for v >= 0, else -1 (zero maps to +1)
inline float RTXGISignNotZero(float v)
{
    // step(0,v) -> 1 if v>=0 else 0; 2*s-1 -> +1 or -1
    return mad(step(0.0f, v), 2.0f, -1.0f);
}

inline float2 RTXGISignNotZero(float2 v)
{
    const float2 s = step(0.0f.xx, v);     // component-wise
    return mad(s, 2.0f.xx, -1.0f.xx);
}

// Round-to-nearest (half-up) into [0..scale]; keep exact behavior
inline uint RTXGIFloatToUint(float v, float scale)
{
    return (uint)floor(mad(v, scale, 0.5f));
}

// Pack float3 into 10:10:10 (no clamp to preserve original behavior)
inline uint RTXGIFloat3ToUint(float3 c)
{
    const uint3 u = (uint3)floor(mad(c, 1023.0f.xxx, 0.5f.xxx));
    return (u.x) | (u.y << 10) | (u.z << 20);
}

// Unpack 10:10:10 to float3
inline float3 RTXGIUintToFloat3(uint p)
{
    const uint x =  p         & 0x3FFu;
    const uint y = (p >> 10)  & 0x3FFu;
    const uint z = (p >> 20)  & 0x3FFu;
    return float3(x, y, z) * RTXGI_INV_1023;
}

// Rotate vector v by quaternion q
inline float3 RTXGIQuaternionRotate(float3 v, float4 q)
{
    const float3 b  = q.xyz;
    const float  ww = q.w * q.w;
    const float  bb = dot(b, b);
    const float  two = 2.0f;
    // v*(w^2 - |b|^2) + b*(2*dot(v,b)) + cross(b,v)*(2*w)
    return mad(v, (ww - bb), mad(b, (two * dot(v, b)), cross(b, v) * (two * q.w)));
}

// Conjugate (inverse for unit quaternions)
inline float4 RTXGIQuaternionConjugate(float4 q)
{
    return float4(-q.xyz, q.w);
}

#endif // RTXGI_COMMON_HLSL
