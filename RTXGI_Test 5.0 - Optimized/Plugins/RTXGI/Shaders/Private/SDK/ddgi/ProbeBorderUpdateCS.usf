// REQUIRED SHADER DEFINES ---------------------------------------------------------------

// PROBE_NUM_TEXELS must be passed in as a define at shader compilation time.
// This define specifies the number of texels of a single dimension of a probe.
// #define PROBE_NUM_TEXELS 6   // probe irradiance is 6x6 texels
// #define PROBE_NUM_TEXELS 14  // probe distance data is 14x14 texels

// PROBE_DATA_REGISTER must be passed in as a define at shader compilation time.
// This define specifies what register the DDGIVolume's probe data is bound to (matching the root signature).
// #define PROBE_DATA_REGISTER u2

// For example usage, see Harness.cpp::CompileVolumeShaders() in the Test Harness.
//Fully optimized by RedPixel
// --------------------------------------------------------------------------------------
#include "/Engine/Private/Common.ush"
#include "../DDGIVolumeDefines.ush"

// Probe irradiance or filtered distance
RWTexture2D<float4> DDGIVolumeProbeDataUAV;

// ---- Compile-time helpers (use bit tricks when (PROBE_NUM_TEXELS+2) is a power of two: 8 or 16) ----
#define PROBE_SIDE_LEN         ( (PROBE_NUM_TEXELS) + 2 )
#define PROBE_SIDE_LEN_M1      ( (PROBE_SIDE_LEN) - 1 )
#if ( (PROBE_SIDE_LEN & (PROBE_SIDE_LEN - 1)) == 0 )
    #define PROBE_SIDE_IS_POW2 1
#else
    #define PROBE_SIDE_IS_POW2 0
#endif

// Mod and align-down by side length (compile to & / mask when possible)
#define MOD_SIDE(v)      ( PROBE_SIDE_IS_POW2 ? ((v) & PROBE_SIDE_LEN_M1) : ((v) % PROBE_SIDE_LEN) )
#define ALIGN_DOWN(v)    ( PROBE_SIDE_IS_POW2 ? ((v) & ~PROBE_SIDE_LEN_M1) : ( ((v) / PROBE_SIDE_LEN) * PROBE_SIDE_LEN ) )

// ---------------------------------------------------------------------------------------------------------------------

[numthreads(8, 8, 1)]
void DDGIProbeBorderRowUpdateCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    // Map thread index to border row texel coordinates (each probe row spans PROBE_SIDE_LEN texels)
    uint2 tc = DispatchThreadID.xy;
    tc.y *= PROBE_SIDE_LEN;

    // Ignore the corner texels
    const uint modx = MOD_SIDE(DispatchThreadID.x);
    if (modx == 0u || modx == PROBE_SIDE_LEN_M1) return;

    // Compute interior texel X to copy from (top/bottom rows)
    const uint probeStart = ALIGN_DOWN(DispatchThreadID.x);
    const uint offset     = PROBE_SIDE_LEN_M1 - modx;
    const uint copyX      = probeStart + offset;

#if RTXGI_DDGI_DEBUG_BORDER_COPY_INDEXING && (RTXGI_DDGI_FORMAT_IRRADIANCE == 1)
    // Top row (debug writes indices)
    DDGIVolumeProbeDataUAV[tc] = float4(tc, uint2(copyX, tc.y + 1));
    // Bottom row
    const uint2 tcBot = uint2(tc.x, tc.y + PROBE_SIDE_LEN_M1);
    DDGIVolumeProbeDataUAV[tcBot] = float4(tcBot, uint2(copyX, tcBot.y - 1));
    return;
#else
    // Top row
    DDGIVolumeProbeDataUAV[tc] = DDGIVolumeProbeDataUAV[uint2(copyX, tc.y + 1)];
    // Bottom row
    tc.y += PROBE_SIDE_LEN_M1;
    DDGIVolumeProbeDataUAV[tc] = DDGIVolumeProbeDataUAV[uint2(copyX, tc.y - 1)];
#endif
}

// ---------------------------------------------------------------------------------------------------------------------

[numthreads(8, 8, 1)]
void DDGIProbeBorderColumnUpdateCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    // Map thread index to border column texel coordinates (each probe column spans PROBE_SIDE_LEN texels)
    uint2 tc = DispatchThreadID.xy;
    tc.x *= PROBE_SIDE_LEN;

    // Handle the corner texels (top/bottom corners of the column)
    const uint mody = MOD_SIDE(tc.y);
    if (mody == 0u || mody == PROBE_SIDE_LEN_M1)
    {
        // Left corner copies from interior opposite edge
        uint2 copy = uint2(tc.x + PROBE_NUM_TEXELS, tc.y - (uint)sign((int)mody - 1) * PROBE_NUM_TEXELS);

    #if RTXGI_DDGI_DEBUG_BORDER_COPY_INDEXING && (RTXGI_DDGI_FORMAT_IRRADIANCE == 1)
        DDGIVolumeProbeDataUAV[tc] = float4(tc, copy);
    #else
        DDGIVolumeProbeDataUAV[tc] = DDGIVolumeProbeDataUAV[copy];
    #endif

        // Right corner
        tc.x += PROBE_SIDE_LEN_M1;
        copy.x = tc.x - PROBE_NUM_TEXELS;

    #if RTXGI_DDGI_DEBUG_BORDER_COPY_INDEXING & (RTXGI_DDGI_FORMAT_IRRADIANCE == 1)
        DDGIVolumeProbeDataUAV[tc] = float4(tc, copy);
    #else
        DDGIVolumeProbeDataUAV[tc] = DDGIVolumeProbeDataUAV[copy];
    #endif
        return;
    }

    // Compute interior texel Y to copy from (left/right columns)
    const uint probeStart = ALIGN_DOWN(tc.y);
    const uint offset     = PROBE_SIDE_LEN_M1 - mody;
    const uint copyY      = probeStart + offset;

#if RTXGI_DDGI_DEBUG_BORDER_COPY_INDEXING && (RTXGI_DDGI_FORMAT_IRRADIANCE == 1)
    // Left column (debug)
    DDGIVolumeProbeDataUAV[tc] = float4(tc, uint2(tc.x + 1, copyY));
    // Right column (debug)
    const uint2 tcRight = uint2(tc.x + PROBE_SIDE_LEN_M1, tc.y);
    DDGIVolumeProbeDataUAV[tcRight] = float4(tcRight, uint2(tcRight.x - 1, copyY));
    return;
#else
    // Left column
    DDGIVolumeProbeDataUAV[tc] = DDGIVolumeProbeDataUAV[uint2(tc.x + 1, copyY)];
    // Right column
    tc.x += PROBE_SIDE_LEN_M1;
    DDGIVolumeProbeDataUAV[tc] = DDGIVolumeProbeDataUAV[uint2(tc.x - 1, copyY)];
#endif
}