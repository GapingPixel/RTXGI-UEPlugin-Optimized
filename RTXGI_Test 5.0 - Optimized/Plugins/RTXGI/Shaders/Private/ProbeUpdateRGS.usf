#define LTCMatTexture               RaytracingLightsDataPacked.LTCMatTexture
#define LTCMatSampler               RaytracingLightsDataPacked.LTCMatSampler
#define LTCAmpTexture               RaytracingLightsDataPacked.LTCAmpTexture
