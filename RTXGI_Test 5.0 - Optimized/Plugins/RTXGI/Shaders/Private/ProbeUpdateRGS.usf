// START RGS PARAMS
RaytracingAccelerationStructure TLAS;

RWTexture2D<float4> RadianceOutput;
RWTexture2D<float4> DebugOutput;

#if RTXGI_DDGI_PARTIAL_UPDATE_ISV
RWTexture2D<uint>   DDGIProbeScrollSpace;
#endif

uint   FrameRandomSeed;

Texture2D<float4>   DDGIVolume_ProbeIrradiance;
Texture2D<float4>   DDGIVolume_ProbeDistance;
Texture2D<float4>   DDGIVolume_ProbeOffsets;
Texture2D<uint>     DDGIVolume_ProbeStates;
SamplerState        DDGIVolume_LinearClampSampler;
float3              DDGIVolume_Radius;
float               DDGIVolume_IrradianceScalar;
float               DDGIVolume_EmissiveMultiplier;
int                 DDGIVolume_ProbeIndexStart;
int                 DDGIVolume_ProbeIndexCount;

float3              Sky_Color;
TextureCube<float4> Sky_Texture;
SamplerState        Sky_TextureSampler;
// END RGS PARAMS

// --------------------------------------------------------------------------------------

float3 GetEnvironmentalRadiance(in float3 direction)
{
#if RTXGI_DDGI_SKY_LIGHT_TYPE == 0
    return 0.0f.xxx;
#elif RTXGI_DDGI_SKY_LIGHT_TYPE == 1
    return Sky_Color * GetSkySHDiffuse(direction);
#else
    return Sky_Color * TextureCubeSampleLevel(Sky_Texture, Sky_TextureSampler, direction, 0).rgb;
#endif
}

void WriteRadianceOutput(uint2 DispatchIndex, float4 value)
{
#if !RTXGI_DDGI_FORMAT_RADIANCE
    const float c_threshold = 1.0f / 255.0f;
    if (RTXGIMaxComponent(value.rgb) <= c_threshold) value.rgb = 0.0f.xxx;
#endif

    // Store scaled; reader will divide by same scalar.
    value.rgb *= DDGIVolume_IrradianceScalar;

#if RTXGI_DDGI_FORMAT_RADIANCE
    RadianceOutput[DispatchIndex] = value;
#else
    const uint packed = RTXGIFloat3ToUint(saturate(value.rgb));
    RadianceOutput[DispatchIndex] = float4(asfloat(packed), value.w, 0.0f, 0.0f);
#endif

#if DDGIVolumeUpdateDebug != 0
    DebugOutput[DispatchIndex] = value;
#endif
}

// --------------------------------------------------------------------------------------

RAY_TRACING_ENTRY_RAYGEN(ProbeUpdateRGS)
{
    // Adapted from ProbeTraceRGS.hlsl in the test harness aiming for minimal changes to help future merges.
    float4 result = 0.0f.xxxx;

    const uint2 DispatchIndex = DispatchRaysIndex().xy;
    const int   rayIndex   = (int)DispatchIndex.x;
    const int   probeIndex = (int)DispatchIndex.y;

#if RTXGI_DDGI_INFINITE_SCROLLING_VOLUME
    const int storageProbeIndex = DDGIGetProbeIndexOffset(probeIndex, DDGIVolume_probeGridCounts, DDGIVolume_probeScrollOffsets);
#else
    const int storageProbeIndex = probeIndex;
#endif
    const int2 texelPosition = DDGIGetProbeTexelPosition(storageProbeIndex, DDGIVolume_probeGridCounts);

#if RTXGI_DDGI_PARTIAL_UPDATE_ISV
    {
        const uint scrollVal = DDGIProbeScrollSpace[texelPosition].x;
        const uint3 prevProbeSpace = uint3(
            scrollVal & 1u,
            (scrollVal >> 1u) & 1u,
            (scrollVal >> 2u) & 1u
        );

        const int3 probeGridCoord = DDGIGetProbeCoords(probeIndex, DDGIVolume.probeGridCounts);
        // floor((coord+offset)/counts) & 1  (use &1 instead of %2)
        const uint3 probeSpace = (uint3)((probeGridCoord + DDGIVolume.probeScrollOffsets) / DDGIVolume.probeGridCounts) & 1u;

        if (all(prevProbeSpace == probeSpace))
            return;
    }
#else
    // Round-robin window check, bail early if outside.
    {
        const int numProbes = DDGIVolume_probeGridCounts.x * DDGIVolume_probeGridCounts.y * DDGIVolume_probeGridCounts.z;
        const int probeRRIndex = (probeIndex < DDGIVolume_ProbeIndexStart) ? (probeIndex + numProbes) : probeIndex;
        if (probeRRIndex >= DDGIVolume_ProbeIndexStart + DDGIVolume_ProbeIndexCount)
            return;
    }
#endif

#if RTXGI_DDGI_PROBE_CLASSIFICATION
    const int probeState = DDGIVolume_ProbeStates.Load(int3(texelPosition, 0));
    if (probeState == PROBE_STATE_INACTIVE && rayIndex >= RTXGI_DDGI_NUM_FIXED_RAYS)
        return;
#endif

#if RTXGI_DDGI_PROBE_RELOCATION
    #if RTXGI_DDGI_INFINITE_SCROLLING_VOLUME
    const float3 probeWorldPosition = DDGIGetProbeWorldPositionWithOffset(probeIndex, DDGIVolume_origin, DDGIVolume_rotation, DDGIVolume_probeGridCounts, DDGIVolume_probeGridSpacing, DDGIVolume_probeScrollOffsets, DDGIVolume_ProbeOffsets);
    #else
    const float3 probeWorldPosition = DDGIGetProbeWorldPositionWithOffset(probeIndex, DDGIVolume_origin, DDGIVolume_rotation, DDGIVolume_probeGridCounts, DDGIVolume_probeGridSpacing, DDGIVolume_ProbeOffsets);
    #endif
#else
    const float3 probeWorldPosition = DDGIGetProbeWorldPosition(probeIndex, DDGIVolume_origin, DDGIVolume_rotation, DDGIVolume_probeGridCounts, DDGIVolume_probeGridSpacing);
#endif

    const float3 probeRayDirection = DDGIGetProbeRayDirection(rayIndex, DDGIVolume_numRaysPerProbe, DDGIVolume_probeRayRotationTransform);

    // Setup the ray
    RayDesc Ray;
    Ray.Origin    = probeWorldPosition;
    Ray.Direction = probeRayDirection;
    Ray.TMin      = 0.0f;
    Ray.TMax      = DDGIVolume_probeMaxRayDistance;

    const int  ReflectedShadowsType = 1;
    const uint RayFlags = 0;
    const uint InstanceInclusionMask = RAY_TRACING_MASK_OPAQUE;

    const bool bShouldDoDirectLighting              = true;
    const bool bShouldDoEmissiveAndIndirectLighting = true;
    const bool bRayTraceSkyLightContribution        = false;
    const bool bDecoupleSampleGeneration            = true;
    const bool bEnableSkyLightContribution          = false;

    float3    PathVertexRadiance = 0.0f.xxx;
    FRayCone  RayCone = (FRayCone)0;
    float     MaxNormalBias = 0.01f;

    // Trace
    const uint linear_rand = DispatchIndex.x + DispatchIndex.y * 9973u;
    RandomSequence RandSequence;
    RandomSequence_Initialize(RandSequence, linear_rand, FrameRandomSeed);
    const uint2 PixelCoord = DispatchRaysIndex().xy;

    FMaterialClosestHitPayload Payload = TraceRayAndAccumulateResults(
        Ray,
        TLAS,
        RayFlags,
        InstanceInclusionMask,
        RandSequence,
        PixelCoord,
        MaxNormalBias,
        ReflectedShadowsType,
        bShouldDoDirectLighting,
        bShouldDoEmissiveAndIndirectLighting,
        bRayTraceSkyLightContribution,
        bDecoupleSampleGeneration,
        RayCone,
        bEnableSkyLightContribution,
        PathVertexRadiance);

    // Adjust emissive (fused)
    PathVertexRadiance += Payload.Radiance * (DDGIVolume_EmissiveMultiplier - 1.0f);

    result = float4(PathVertexRadiance, Payload.HitT);

    // Miss → big hit distance, add environment, early out
    if (Payload.IsMiss())
    {
        result.rgb += GetEnvironmentalRadiance(Ray.Direction);
        result.w = 1e27f;
        WriteRadianceOutput(DispatchIndex, result);
        return;
    }

    // Backface → encode negative shortened distance, early out
    if (!Payload.IsFrontFace() && Payload.ShadingModelID != SHADINGMODELID_TWOSIDED_FOLIAGE)
    {
        WriteRadianceOutput(DispatchIndex, float4(0.0f, 0.0f, 0.0f, -Payload.HitT * 0.2f));
        return;
    }

#if RTXGI_DDGI_PROBE_CLASSIFICATION
    if (probeState == PROBE_STATE_INACTIVE)
    {
        WriteRadianceOutput(DispatchIndex, float4(0.0f, 0.0f, 0.0f, Payload.HitT));
        return;
    }
#endif

    // DDGI lighting
    float3 probeLighting = 0.0f.xxx;
    {
        // Albedo = baseColor * (1-metallic)
        const float3 albedo = Payload.BaseColor * (1.0f - Payload.Metallic);

        // Fill resources
        DDGIVolumeResources resources;
        resources.probeIrradianceSRV = DDGIVolume_ProbeIrradiance;
        resources.probeDistanceSRV   = DDGIVolume_ProbeDistance;
        resources.bilinearSampler    = DDGIVolume_LinearClampSampler;
    #if RTXGI_DDGI_PROBE_RELOCATION
        resources.probeOffsetsSRV    = DDGIVolume_ProbeOffsets;
    #endif
    #if RTXGI_DDGI_PROBE_CLASSIFICATION
        resources.probeStatesSRV     = DDGIVolume_ProbeStates;
    #endif

        // Volume descriptor
        DDGIVolumeDescGPU DDGIVolume_0;
        DDGIVolume_0.origin                      = DDGIVolume_origin;
        DDGIVolume_0.rotation                    = DDGIVolume_rotation;
        DDGIVolume_0.probeMaxRayDistance         = DDGIVolume_probeMaxRayDistance;
        DDGIVolume_0.probeGridCounts             = DDGIVolume_probeGridCounts;
        DDGIVolume_0.probeRayRotationTransform   = DDGIVolume_probeRayRotationTransform;
        DDGIVolume_0.numRaysPerProbe             = DDGIVolume_numRaysPerProbe;
        DDGIVolume_0.probeGridSpacing            = DDGIVolume_probeGridSpacing;
        DDGIVolume_0.probeNumIrradianceTexels    = DDGIVolume_probeNumIrradianceTexels;
        DDGIVolume_0.probeNumDistanceTexels      = DDGIVolume_probeNumDistanceTexels;
        DDGIVolume_0.probeIrradianceEncodingGamma= DDGIVolume_probeIrradianceEncodingGamma;
        DDGIVolume_0.normalBias                  = DDGIVolume_normalBias;
        DDGIVolume_0.viewBias                    = DDGIVolume_viewBias;
        DDGIVolume_0.probeScrollOffsets          = DDGIVolume_probeScrollOffsets;

        // Irradiance sample
        const float3 surfacePosWS = mad(Ray.Direction, Payload.HitT, Ray.Origin);
        const float3 surfaceBias  = DDGIGetSurfaceBias(Payload.WorldNormal, Ray.Direction, DDGIVolume_0);

        float3 irradiance = DDGIGetVolumeIrradiance(
            surfacePosWS,
            surfaceBias,
            Payload.WorldNormal,
            DDGIVolume_0,
            resources
        );

        // Limit BRDF albedo, scale by 1/pi and volume irradiance scalar
        const float  maxAlbedo  = 0.9f;
        const float  invPI      = 0.31830988618379067f; // 1/pi
        const float  invIrr     = rcp(DDGIVolume_IrradianceScalar);
        const float3 albClamped = min(albedo, maxAlbedo);

        probeLighting = irradiance * (albClamped * (invPI * invIrr));

        // Zero lighting outside the volume (strict '>' as original)
        const float3 relPos = abs(surfacePosWS - DDGIVolume_origin);
        if (relPos.x > DDGIVolume_Radius.x || relPos.y > DDGIVolume_Radius.y || relPos.z > DDGIVolume_Radius.z)
            probeLighting = 0.0f.xxx;
    }

    WriteRadianceOutput(DispatchIndex, float4(result.rgb + probeLighting, Payload.HitT));
}
