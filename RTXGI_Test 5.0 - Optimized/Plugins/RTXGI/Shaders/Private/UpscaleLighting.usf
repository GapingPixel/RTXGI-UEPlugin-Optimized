#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"

/*
 * Fully optimized by RedPixel
 */

Texture2D<float4>   InputGITexture;
Texture2D<float4>   NormalTexture;
Texture2D<float>    DepthTexture;
Texture2D<float4>   BaseColorTexture;
Texture2D<float4>   MetallicTexture;

RWTexture2D<float4> SceneColorOutput;

SamplerState        PointClampSampler;
SamplerState        LinearClampSampler;

float4              InputViewSizeAndInvSize;
float               RelativeDistanceThreshold;
float               NormalPower;

struct BilinearFilter
{
    int2   Origin;
    float2 Weights;
};

// (a + (b-a)*t) version (fewer ops than nested lerp)
float  Lerp1(float  a, float  b, float  t) { return mad(b - a, t, a); }
float4 Lerp4(float4 a, float4 b, float  t) { return mad(b - a, t, a); }

BilinearFilter GetBilinearFilter(float2 UV, float2 TexSize)
{
    const float2 T = mad(UV, TexSize, -0.5f);
    BilinearFilter r;
    r.Origin  = int2(floor(T));
    r.Weights = T - r.Origin;        // == frac(T) for T>=0
    return r;
}

float ApplyBilinearFilter(float S00, float S10, float S01, float S11, BilinearFilter f)
{
    const float hx0 = Lerp1(S00, S10, f.Weights.x);
    const float hx1 = Lerp1(S01, S11, f.Weights.x);
    return Lerp1(hx0, hx1, f.Weights.y);
}

float4 ApplyBilinearFilter(float4 S00, float4 S10, float4 S01, float4 S11, BilinearFilter f)
{
    const float4 hx0 = Lerp4(S00, S10, f.Weights.x);
    const float4 hx1 = Lerp4(S01, S11, f.Weights.x);
    return Lerp4(hx0, hx1, f.Weights.y);
}

float4 BilinearWithCustomWeightsFloat4(Texture2D<float4> Tex, BilinearFilter f, float4 w, float interpW)
{
    // 2x2 texel fetches (point), preweight then bilinear, then normalize
    const int2 o = f.Origin;
    float4 S00 = Tex[o + int2(0,0)];
    float4 S10 = Tex[o + int2(1,0)];
    float4 S01 = Tex[o + int2(0,1)];
    float4 S11 = Tex[o + int2(1,1)];

    S00 *= w.x;  S10 *= w.y;  S01 *= w.z;  S11 *= w.w;

    float4 res = ApplyBilinearFilter(S00, S10, S01, S11, f);
    res *= rcp(interpW);                 // divide → mul by rcp
    return res;
}

float GetGeometryWeight(float SceneDepth, float3 WorldPosition, float3 Normal, float3 SampleWorldPosition, float3 SampleNormal)
{
    const float  invRel = rcp(RelativeDistanceThreshold * SceneDepth);
    const float  plane  = dot(Normal, WorldPosition - SampleWorldPosition);
    const float  rel    = plane * invRel;                       // PlaneDistance / (RDT * SceneDepth)

    const float  pdw    = smoothstep(0.f, 1.f, 1.f - rel);      // PlaneDistanceWeight
    const float  ndot   = saturate(dot(Normal, SampleNormal));
    const float  nrmW   = (NormalPower == 0.f) ? 1.f : pow(ndot, NormalPower);

    return pdw * nrmW;
}

float GetTapWeight(int2 pixel, float SceneDepth, float3 WorldPosition, float3 Normal)
{
    // Pre-calc common view params
    const float2 invView  = View.ViewSizeAndInvSize.zw;
    const float2 viewSize = View.ViewSizeAndInvSize.xy;
    const float2 invBuf   = View.BufferSizeAndInvSize.zw;
    const float2 rectMin  = View.ViewRectMin.xy;

    // TapScreenUV = (pixel + 0.5) * invViewInput  (pixel is in Input space)
    const float2 tapUV    = mad((float2)pixel, invView, 0.5f * invView);

    // Nearest GBuffer UV
    const int2   gbPix    = int2(tapUV * viewSize);             // floor() == (int) for UV>=0
    const float2 gbUV     = mad((float2)gbPix, invView, 0.5f * invView);
    const float2 clipXY   = mad(gbUV, float2(2.f, -2.f), float2(-1.f, 1.f));
    const float4 pos      = float4(clipXY, 0.f, 1.f);
    const float3 inScrVec = mul(pos.xyxy, View.ScreenToTranslatedWorld).xyz;

    // Buffer UV → derive integer pixel for point (use Load)
    const int2   bufPix   = int2(tapUV * viewSize + rectMin);
    const float  devZ     = DepthTexture.Load(int3(bufPix, 0)).r;
    const float  tapDepth = ConvertFromDeviceZ(devZ);

#if UE4_COMPAT
    const float3 tapWS    = mad(inScrVec, tapDepth, View.WorldCameraOrigin);
#else
    const float3 tapWS    = mad(inScrVec, tapDepth, LWCHackToFloat(PrimaryView.WorldCameraOrigin));
#endif

    const float3 tapN     = normalize(DecodeNormal(NormalTexture.Load(int3(bufPix, 0)).xyz));
    return GetGeometryWeight(SceneDepth, WorldPosition, Normal, tapWS, tapN);
}

float3 GetAlbedo(int2 PixelIndex)
{
    const float3 bc = DecodeBaseColor(BaseColorTexture.Load(int3(PixelIndex, 0)).rgb);
    const float  m  = MetallicTexture.Load(int3(PixelIndex, 0)).r;
    return bc * (1.f - m);                 // BaseColor - BaseColor * Metallic
}

#define THGP_DIM 8
[numthreads(THGP_DIM, THGP_DIM, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    // Pixel & UV in view space
    const int2   PixelIndex = int2(DispatchThreadID.xy) + View.ViewRectMin.xy;
    const float2 invView    = View.ViewSizeAndInvSize.zw;
    const float2 ScreenUV   = mad((float2)DispatchThreadID.xy, invView, 0.5f * invView);

    // Clip → world direction
    const float2 clipXY     = mad(ScreenUV, float2(2.f, -2.f), float2(-1.f, 1.f));
    const float4 pos        = float4(clipXY, 0.f, 1.f);
    const float3 inScrVec   = mul(pos.xyxy, View.ScreenToTranslatedWorld).xyz;

    // Depth/WS/Normal at current pixel (point/Load)
    const float  devZ       = DepthTexture.Load(int3(PixelIndex, 0)).r;
    const float  SceneDepth = ConvertFromDeviceZ(devZ);
#if UE4_COMPAT
    const float3 WorldPosition = mad(inScrVec, SceneDepth, View.WorldCameraOrigin);
#else
    const float3 WorldPosition = mad(inScrVec, SceneDepth, LWCHackToFloat(PrimaryView.WorldCameraOrigin));
#endif
    const float3 Normal     = normalize(DecodeNormal(NormalTexture.Load(int3(PixelIndex, 0)).xyz));

    const float3 Albedo     = GetAlbedo(PixelIndex);

    // Bilinear footprint in Input space
    const BilinearFilter f  = GetBilinearFilter(ScreenUV, InputViewSizeAndInvSize.xy);

    // 2x2 geometry-aware tap weights
    float4 tapW = 0;
    // Unroll the four taps explicitly (avoids loop overhead/divergence)
    tapW.x = GetTapWeight(f.Origin + int2(0,0), SceneDepth, WorldPosition, Normal);
    tapW.y = GetTapWeight(f.Origin + int2(1,0), SceneDepth, WorldPosition, Normal);
    tapW.z = GetTapWeight(f.Origin + int2(0,1), SceneDepth, WorldPosition, Normal);
    tapW.w = GetTapWeight(f.Origin + int2(1,1), SceneDepth, WorldPosition, Normal);

    const float interpW = ApplyBilinearFilter(tapW.x, tapW.y, tapW.z, tapW.w, f);

    if (interpW > 0.01f)
    {
        // Geometry-weighted upsample (normalize by interpW)
        const float4 upGI = BilinearWithCustomWeightsFloat4(InputGITexture, f, tapW, interpW);
        SceneColorOutput[PixelIndex] += float4(upGI.rgb * Albedo, upGI.a);
    }
    else
    {
        // Fallback to regular bilinear (same as original)
        const float4 gi = InputGITexture.SampleLevel(LinearClampSampler, ScreenUV, 0.f);
        SceneColorOutput[PixelIndex] += float4(gi.rgb * Albedo, gi.a);
    }
}
